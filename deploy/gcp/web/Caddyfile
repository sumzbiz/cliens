# Frontend on Cloud Run: the built single-page app, and /api proxied to the
# backend's internal-only Cloud Run service.
#
# Cloud Run terminates TLS and sets PORT; Caddy only listens on plain HTTP.
# API_UPSTREAM is the backend's https://...run.app URL, set by Terraform.

{
	admin off
	# Every request arrives through Google's front end, so the client address is
	# in X-Forwarded-For rather than the TCP peer. Trusting it here passes the
	# chain on to the backend, whose per-IP rate limiter reads it.
	servers {
		trusted_proxies static 0.0.0.0/0 ::/0
	}
}

:{$PORT:8080} {
	encode zstd gzip

	handle /api/* {
		reverse_proxy {$API_UPSTREAM} {
			# Cloud Run routes on the Host header, so it must name the backend
			# service, not the frontend the browser asked for.
			header_up Host {http.reverse_proxy.upstream.host}

			# An uncached Earth Engine outlook may take up to the backend's 90 s
			# budget; these sit above it so the backend's own typed timeout error,
			# not a proxy cut-off, is what the browser sees.
			transport http {
				response_header_timeout 110s
				read_timeout 120s
			}
		}
	}

	handle {
		root * /srv/site

		@immutable path /assets/*
		header @immutable Cache-Control "public, max-age=31536000, immutable"
		header /index.html Cache-Control "no-cache"

		try_files {path} /index.html
		file_server
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	log {
		output stdout
		format json
	}
}
