# Copy to `.env` and fill in. `.env` is gitignored and must never be committed.
#
#   cp .env.example .env        (PowerShell: Copy-Item .env.example .env)
#
# The app starts without any of the third-party credentials below. Endpoints that
# need a missing credential return an explicit typed error (HTTP 503,
# code=EXTERNAL_SERVICE_UNCONFIGURED) rather than fabricated data.

# ---------------------------------------------------------------------------
# Database — must match config/docker-compose.yml
# ---------------------------------------------------------------------------
POSTGRES_USER=cls
POSTGRES_PASSWORD=cls_dev_password
POSTGRES_DB=climate_lien_score

# Async driver (asyncpg) is used by the application at runtime.
DATABASE_URL=postgresql+asyncpg://cls:cls_dev_password@localhost:5433/climate_lien_score

# Alembic runs migrations synchronously and needs the psycopg driver instead.
DATABASE_URL_SYNC=postgresql+psycopg://cls:cls_dev_password@localhost:5433/climate_lien_score

# Integration tests point at the disposable test-db container (port 5434).
TEST_DATABASE_URL=postgresql+asyncpg://cls:cls_dev_password@localhost:5434/climate_lien_score_test

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# "development" enables verbose human-readable logs; "production" emits JSON only.
ENVIRONMENT=development
LOG_LEVEL=INFO

# Comma-separated exact origins allowed by CORS. No wildcards in production.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Per-IP rate limit applied to public endpoints, as requests per window.
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# ---------------------------------------------------------------------------
# Sarvam AI — Tamil voice narration of questions and options
#
# Two keys from two accounts. The app uses the primary until it reports a rate or
# quota limit, then switches to the secondary for the rest of the session. Both
# are optional: with neither set the interface simply has no Listen buttons, and
# every question stays fully usable as text.
#
# Keys: https://dashboard.sarvam.ai/
# The speaker must be one the chosen model actually offers, and the model's list
# is not the same as the docs' general list. Verified live against bulbul:v3 for
# Tamil: kavitha, shruti, ritu, roopa (female), anand, vijay (male).
# ---------------------------------------------------------------------------
SARVAM_API_KEY_PRIMARY=
SARVAM_API_KEY_SECONDARY=
SARVAM_TTS_SPEAKER=kavitha
SARVAM_TTS_LANGUAGE=ta-IN

# ---------------------------------------------------------------------------
# Mapbox — deeper satellite imagery (optional)
#
# Leave blank and the map uses Esri, which publishes nothing past zoom 19
# (~0.3 m per pixel) — enough to see a building's outline, not its roof.
#
# With a token the map reaches zoom 22 in populated areas (~0.04 m per pixel),
# which is the level at which roof structure and individual trees resolve.
# Free tier: 200,000 tile requests/month, then billed. Get one at
# https://account.mapbox.com/access-tokens/ — a public token (pk....) is correct.
#
# THIS IS THE ONLY METERED SERVICE IN THE APP. Everything else is keyless.
# ---------------------------------------------------------------------------
MAPBOX_ACCESS_TOKEN=

# ---------------------------------------------------------------------------
# Google Gemini — report generation (feature 8)
# Free-tier key: https://aistudio.google.com/app/apikey
# ---------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ---------------------------------------------------------------------------
# Google Earth Engine — CMIP6 climate projections + hazard layers (feature 2)
#
# Requires BOTH:
#   1. A Google Cloud project with the Earth Engine API enabled, registered at
#      https://code.earthengine.google.com/register
#   2. A service account in that project, granted the Earth Engine Resource
#      Viewer role, with a downloaded JSON key.
#
# EARTH_ENGINE_SERVICE_ACCOUNT_FILE is an absolute path to that JSON key.
# ---------------------------------------------------------------------------
EARTH_ENGINE_PROJECT_ID=
EARTH_ENGINE_SERVICE_ACCOUNT_EMAIL=
EARTH_ENGINE_SERVICE_ACCOUNT_FILE=

# ---------------------------------------------------------------------------
# India Meteorological Department — historical cyclone/rainfall context
#
# IMD publishes no documented, versioned, keyed public REST API. This base URL is
# the undocumented endpoint the client targets; it can change without notice and is
# periodically IP-restricted. When it is unreachable the client falls back to the
# bundled, clearly-labelled cached dataset (see README "Known limitations").
# ---------------------------------------------------------------------------
IMD_API_BASE_URL=https://api.imd.gov.in
IMD_REQUEST_TIMEOUT_SECONDS=10
